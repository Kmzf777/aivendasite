# Chave da API da TypeSafe (https://typesafe.ai) - usada so no servidor, nunca no browser.
TYPESAFE_API_KEY=

# Supabase — painel do projeto > Settings > API
# A anon key e publica por desenho; quem protege os dados e o RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada so por script de importacao, do lado do servidor. Ela IGNORA o RLS.
SUPABASE_SERVICE_ROLE_KEY=
